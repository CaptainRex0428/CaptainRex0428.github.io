---
export interface Props {
  href?: string;
  title?: string;
  description?: string;
  cover?: string;
  badge?: string;
  badgeText?: string;
  date?: string;
  tags?: string[];
}

const { href, title, description, cover, badge, badgeText, date, tags = [] } = Astro.props;
const cardModeClass = cover ? 'card--with-cover' : 'card--without-cover';
---

{href ? (
  <a href={href} class="card-link">
    <article class={`card ${cardModeClass}`}>
      {cover && (
        <div class="card-cover">
          <img src={cover} alt={title || ''} loading="lazy" />
        </div>
      )}
      <div class="card-content">
        {badge && <span class="badge">{badgeText || badge}</span>}
        {title && <h3 class="card-title">{title}</h3>}
        {description && <p class="card-desc">{description}</p>}
        {tags.length > 0 && (
          <div class="card-tags" data-collapsible-tags>
            {tags.map(tag => (
              <span class="tag" data-card-tag>#{tag}</span>
            ))}
            <span class="tag-line-break" data-tag-line-break hidden></span>
            <span class="tag tag-ellipsis" data-tag-ellipsis hidden aria-label="More tags">...</span>
          </div>
        )}
        <div class="card-meta">
          {date && <time class="card-date">{date}</time>}
          <span class="card-arrow">&rarr;</span>
        </div>
      </div>
    </article>
  </a>
) : (
  <article class={`card ${cardModeClass}`}>
    {cover && (
      <div class="card-cover">
        <img src={cover} alt={title || ''} loading="lazy" />
      </div>
    )}
    <div class="card-content">
      {badge && <span class="badge">{badgeText || badge}</span>}
      {title && <h3 class="card-title">{title}</h3>}
      {description && <p class="card-desc">{description}</p>}
      {date && <time class="card-date">{date}</time>}
    </div>
  </article>
)}

<style>
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    --card-tag-max-rows: 3;
  }

  .card--with-cover {
    --card-tag-max-rows: 3;
    --card-desc-lines: 5;
  }

  .card--without-cover {
    --card-tag-max-rows: 3;
    --card-desc-lines: 3;
  }

  .card-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
    background: var(--bg-base);
  }

  .card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .card:hover .card-cover img {
    transform: scale(1.05);
  }

  .card:hover .card-cover img {
    transform: scale(1.05);
  }

  .card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .badge {
    align-self: flex-start;
    margin-bottom: var(--space-3);
  }

  .card-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .card:hover .card-title {
    color: var(--accent);
  }

  .card-desc {
    display: -webkit-box;
    -webkit-line-clamp: var(--card-desc-lines);
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }

  .card-tags {
    --tag-chip-height: calc((var(--text-xs) * 1.4) + (var(--space-1) * 2) + 2px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    height: calc((var(--tag-chip-height) * var(--card-tag-max-rows)) + (var(--space-2) * (var(--card-tag-max-rows) - 1)));
    overflow: hidden;
  }

  .card-tags .tag {
    display: inline-flex;
    align-items: center;
    min-height: var(--tag-chip-height);
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--text-secondary);
    background: var(--bg-base);
    border: 1px solid var(--bg-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .card-tags .tag-line-break {
    display: block;
    flex-basis: 100%;
    height: 0;
  }

  .card-tags .tag-line-break[hidden],
  .card-tags .tag-ellipsis[hidden],
  .card-tags .tag.is-hidden-by-overflow {
    display: none;
  }

  .card-tags .tag-ellipsis {
    color: var(--text-muted);
  }

  .card:hover .card-tags .tag {
    background: transparent;
    border-color: transparent;
  }

  .card-date {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .card-arrow {
    flex-shrink: 0;
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--text-muted);
    transition: all var(--transition-fast);
  }

  .card:hover .card-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }
</style>

<script>
  const updateCollapsedTags = () => {
    document.querySelectorAll<HTMLElement>('[data-collapsible-tags]').forEach(container => {
      const tags = Array.from(container.querySelectorAll<HTMLElement>('[data-card-tag]'));
      const lineBreak = container.querySelector<HTMLElement>('[data-tag-line-break]');
      const ellipsis = container.querySelector<HTMLElement>('[data-tag-ellipsis]');

      if (!lineBreak || !ellipsis || tags.length === 0) return;

      tags.forEach(tag => tag.classList.remove('is-hidden-by-overflow'));
      lineBreak.hidden = true;
      ellipsis.hidden = true;

      const rowTops = tags.reduce<number[]>((rows, tag) => {
        const top = Math.round(tag.offsetTop);
        if (!rows.includes(top)) rows.push(top);
        return rows;
      }, []);

      if (rowTops.length <= 3) return;

      const thirdRowTop = rowTops[2];
      tags.forEach(tag => {
        if (Math.round(tag.offsetTop) >= thirdRowTop) {
          tag.classList.add('is-hidden-by-overflow');
        }
      });

      lineBreak.hidden = false;
      ellipsis.hidden = false;
    });
  };

  let resizeFrame = 0;
  const scheduleCollapsedTagsUpdate = () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(updateCollapsedTags);
  };

  updateCollapsedTags();
  window.addEventListener('load', updateCollapsedTags);
  window.addEventListener('resize', scheduleCollapsedTagsUpdate);
  document.fonts?.ready.then(updateCollapsedTags);
</script>
