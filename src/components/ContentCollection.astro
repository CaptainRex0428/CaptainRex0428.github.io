---
import Card from '@/components/Card.astro';
import PostListItem from '@/components/PostListItem.astro';
import DynamicTagFilter from '@/components/DynamicTagFilter.astro';
import ViewToggle from '@/components/ViewToggle.astro';
import SortDropdown from '@/components/SortDropdown.astro';
import { formatDateShort } from '@/utils/formatDate';
import { getHeroImage } from '@/utils/heroImage';
import { getContentSlug } from '@/utils/contentSlug';

export interface Props {
  items: any[];
  type: 'posts' | 'works';
  title: string;
  emptyText: string;
  basePath: string;
  filterId: string;
  showSort?: boolean;
}

const { items, type, title, emptyText, basePath, filterId, showSort = false } = Astro.props;
const tags = [...new Set(items.flatMap(item => item.data.tags || []))];
const containerId = type === 'posts' ? 'posts-container' : 'works-container';
---

<section class={`${type}-section content-collection`}>
  <div class="section-header">
    <h2 class="section-title">{title}</h2>
    <div class="header-controls">
      {showSort && <SortDropdown id={`${type}-sort`} targetContainer={containerId} />}
      <ViewToggle />
    </div>
  </div>

  {tags.length > 0 && (
    <DynamicTagFilter
      id={filterId}
      labels={tags}
      targetType={type}
      maxVisible={8}
    />
  )}

  {items.length > 0 ? (
    <div class="grid-auto" id={containerId} data-content-type={type}>
      {items.map(item => {
        const heroImg = getHeroImage(item);
        const href = `${basePath}/${getContentSlug(item)}`;
        const date = item.data.date ? formatDateShort(item.data.date) : undefined;
        const dateISO = item.data.date ? item.data.date.toISOString() : undefined;

        return (
          <div class={`content-item${heroImg ? ' has-cover' : ''}`}
               data-content-type={type}
               data-tags={(item.data.tags || []).join(',')}
               data-date={dateISO}>
            <div class="grid-view-component">
              <Card
                href={href}
                title={item.data.title}
                description={item.data.description}
                cover={heroImg}
                tags={item.data.tags}
                date={date}
              />
            </div>
            <div class="list-view-component">
              <PostListItem
                href={href}
                title={item.data.title}
                description={item.data.description}
                cover={heroImg}
                tags={item.data.tags}
                date={date}
              />
            </div>
          </div>
        );
      })}
    </div>
  ) : (
    <div class="empty-state">
      <p>{emptyText}</p>
    </div>
  )}
</section>

<style>
  .content-collection {
    margin-bottom: var(--space-12);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .grid-auto {
    align-items: stretch !important;
  }

  .grid-auto .grid-view-component {
    display: block;
    height: 100%;
  }

  .grid-auto .content-item {
    height: 100%;
  }

  .grid-auto .list-view-component {
    display: none;
  }

  .posts-list,
  .works-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .posts-list .content-item,
  .works-list .content-item {
    padding: 0;
    background: transparent;
    border: none;
  }

  .posts-list .grid-view-component,
  .works-list .grid-view-component {
    display: none;
  }

  .posts-list .list-view-component,
  .works-list .list-view-component {
    display: block;
  }

  .content-item {
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .content-item.hidden {
    display: none !important;
  }

  .content-item.fade-in {
    animation: fadeIn var(--transition-base) ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .section-header {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-4);
    }
  }
</style>
