---
import { getLocaleFromUrl, useTranslations } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const socials = [
  { label: '图灵技术手记', href: 'https://www.zhihu.com/people/turing-digiart' },
  { label: '图灵数字艺术', href: 'https://www.xiaohongshu.com/user/profile/697ed5bd00000000210136e2' },
  { label: '图灵数字艺术技术手记', href: 'https://www.xiaohongshu.com/user/profile/6709d2da000000001d03100c' },
  { label: '图灵数字艺术RestArt', href: 'https://space.bilibili.com/504030884' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <span class="brand-name">CaptainRex</span>
        <div class="brand-tags">
          <span class="brand-tag">游戏资深技术美术（TA）</span>
          <span class="brand-tag">中国传媒大学数字艺术 MA</span>
          <span class="brand-tag">腾讯数字艺术领军人才实验班讲师</span>
          <span class="brand-tag">数字艺术技术讲师</span>
          <span class="brand-tag">数字艺术理论讲师</span>
        </div>
      </div>

      <div class="footer-social">
        <h4 class="social-title">社交平台</h4>
        <div class="social-links">
          {socials.map(s => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
            >
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {new Date().getFullYear()} CaptainRex. {t.footer.copyright}.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding: var(--space-16) 0 var(--space-8);
    background: var(--bg-elevated);
    border-top: 1px solid var(--bg-border);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  .footer-brand {
    max-width: 400px;
  }

  .brand-name {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
  }

  .brand-tags {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  .brand-tag {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .footer-social {
    text-align: right;
  }

  .social-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-end;
  }

  .social-link {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: var(--space-1) 0;
  }

  .social-link:hover {
    color: var(--accent);
  }

  .footer-bottom {
    padding-top: var(--space-8);
    border-top: 1px solid var(--bg-border);
    text-align: center;
  }

  .copyright {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .footer-social {
      text-align: left;
    }

    .social-links {
      align-items: flex-start;
    }
  }
</style>