---
export interface Props {
  href: string;
  title: string;
  description: string;
  cover?: string;
  tags: string[];
  itemCount: number;
}

const { href, title, description, cover, tags, itemCount } = Astro.props;
const defaultCover = '/DefaultCover.png';
const displayCover = cover || defaultCover;
---

<a href={href} class="series-card">
  <div class="series-cover">
    <img src={displayCover} alt={title} loading="lazy" width="320" height="180" />
  </div>
  <div class="series-content">
    <h3 class="series-title">{title}</h3>
    <p class="series-desc">{description}</p>
    <div class="series-tags">
      {tags.slice(0, 5).map(tag => (
        <span class="tag">#{tag}</span>
      ))}
      {tags.length > 5 && <span class="tag tag-more">+{tags.length - 5}</span>}
    </div>
    <div class="series-footer">
      <span class="series-count">{itemCount} 篇</span>
      <span class="series-arrow">&rarr;</span>
    </div>
  </div>
</a>

<style>
  .series-card {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
  }

  .series-card:hover {
    border-color: var(--accent);
    background: var(--accent-glow);
    transform: translateY(-2px);
  }

  .series-cover {
    flex-shrink: 0;
    width: 200px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-base);
  }

  .series-card:hover .series-cover img {
    transform: scale(1.05);
  }

  .series-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .series-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .series-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
    transition: color var(--transition-fast);
  }

  .series-card:hover .series-title {
    color: var(--accent);
  }

  .series-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .series-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .series-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .series-tags .tag {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: var(--bg-base);
    border: 1px solid var(--bg-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .series-card:hover .series-tags .tag {
    background: transparent;
    border-color: transparent;
  }

  .tag-more {
    color: var(--text-muted);
  }

  .series-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .series-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    font-size: var(--text-lg);
    color: var(--text-muted);
    transition: all var(--transition-fast);
  }

  .series-card:hover .series-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  .series-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-4);
  }

  @media (max-width: 768px) {
    .series-card {
      flex-direction: column;
      gap: var(--space-4);
    }

    .series-cover {
      width: 100%;
    }
  }
</style>