---
export interface Props {
  href: string;
  title: string;
  description: string;
  cover: string;
  tags: string[];
  itemCount: number;
}

const { href, title, description, cover, tags, itemCount } = Astro.props;
---

<a href={href} class="series-card">
  <div class="series-cover">
    <img src={cover} alt={title} loading="lazy" />
  </div>
  <div class="series-content">
    <h3 class="series-title">{title}</h3>
    <p class="series-desc">{description}</p>
    <div class="series-meta">
      <div class="series-tags">
        {tags.slice(0, 5).map(tag => (
          <span class="tag">#{tag}</span>
        ))}
        {tags.length > 5 && <span class="tag tag-more">+{tags.length - 5}</span>}
      </div>
      <span class="series-count">{itemCount} 篇</span>
    </div>
    <span class="series-arrow">&rarr;</span>
  </div>
</a>

<style>
  .series-card {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
  }

  .series-card:hover {
    border-color: var(--accent);
    background: var(--accent-glow);
    transform: translateY(-2px);
  }

  .series-cover {
    flex-shrink: 0;
    width: 200px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-base);
  }

  .series-card:hover .series-cover img {
    transform: scale(1.05);
  }

  .series-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .series-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .series-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
    transition: color var(--transition-fast);
  }

  .series-card:hover .series-title {
    color: var(--accent);
  }

  .series-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .series-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .series-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .series-card:hover .tag {
    color: var(--accent-bright);
  }

  .tag-more {
    color: var(--text-muted);
  }

  .series-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .series-arrow {
    position: absolute;
    bottom: var(--space-6);
    right: var(--space-6);
    font-size: var(--text-lg);
    color: var(--text-muted);
    transition: all var(--transition-fast);
  }

  .series-card:hover .series-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .series-card {
      flex-direction: column;
      gap: var(--space-4);
    }

    .series-cover {
      width: 100%;
    }

    .series-arrow {
      position: static;
      margin-top: var(--space-4);
    }
  }
</style>