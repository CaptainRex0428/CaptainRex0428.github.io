---
import Base from '@/layouts/Base.astro';
import { useTranslations, getLocaleFromUrl } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Base title={t.about.title}>
  <section class="about section">
    <div class="container">
      <div class="about-header animate-slide-up">
        <h1 class="about-title">{t.about.title}</h1>
        <p class="about-intro">{t.about.intro}</p>
      </div>

      <div class="about-grid">
        <div class="about-card card">
          <h2 class="card-title">{t.about.skills}</h2>
          <div class="skills-grid">
            <div class="skill-item">
              <span class="skill-icon">⚡</span>
              <h3>{t.about.skillsList.ta}</h3>
              <p>游戏 TA / 图形学</p>
            </div>
            <div class="skill-item">
              <span class="skill-icon">🎮</span>
              <h3>{t.about.skillsList.ue}</h3>
              <p>UE5 / DirectX / C++</p>
            </div>
            <div class="skill-item">
              <span class="skill-icon">🎨</span>
              <h3>{t.about.skillsList.tools}</h3>
              <p>Blender / Houdini</p>
            </div>
            <div class="skill-item">
              <span class="skill-icon">✍️</span>
              <h3>{t.about.skillsList.writing}</h3>
              <p>技术文章与出版</p>
            </div>
          </div>
        </div>

        <div class="about-card card social-card">
          <h2 class="card-title">社交平台</h2>
          <div class="social-buttons">
            <div class="social-row">
              <span class="social-label">知乎</span>
              <div class="social-btns">
                <a href="https://www.zhihu.com/people/turing-digiart" target="_blank" rel="noopener" class="social-btn zhihu">
                  <span>图灵技术手记</span>
                </a>
              </div>
            </div>
            <div class="social-row">
              <span class="social-label">小红书</span>
              <div class="social-btns">
                <a href="https://www.xiaohongshu.com/user/profile/697ed5bd00000000210136e2" target="_blank" rel="noopener" class="social-btn xhs">
                  <span>图灵数字艺术</span>
                </a>
                <a href="https://www.xiaohongshu.com/user/profile/6709d2da000000001d03100c" target="_blank" rel="noopener" class="social-btn xhs">
                  <span>图灵数字艺术技术手记</span>
                </a>
              </div>
            </div>
            <div class="social-row">
              <span class="social-label">BiliBili</span>
              <div class="social-btns">
                <a href="https://space.bilibili.com/504030884" target="_blank" rel="noopener" class="social-btn bilibili">
                  <span>图灵数字艺术RestArt</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-header {
    margin-bottom: var(--space-12);
    max-width: 700px;
  }

  .about-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .about-intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-6);
  }

  .about-card {
    padding: var(--space-8);
  }

  .card-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .skill-item {
    text-align: center;
    padding: var(--space-4);
    background: var(--bg-base);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .skill-item:hover {
    background: var(--accent-glow);
    transform: translateY(-2px);
  }

  .skill-icon {
    font-size: var(--text-2xl);
    display: block;
    margin-bottom: var(--space-3);
  }

  .skill-item h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .skill-item p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  .social-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .social-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .social-label {
    width: 60px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .social-btns {
    display: flex;
    gap: var(--space-3);
    flex: 1;
  }

  .social-row .social-btn {
    flex: 1;
    max-width: none;
    justify-content: center;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-4);
    min-width: 140px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-base);
    box-shadow: 0 0 8px rgba(74, 74, 74, 0.2);
  }

  .social-btn.xhs {
    font-size: var(--text-xs);
    white-space: normal;
    text-align: center;
    line-height: 1.4;
  }

  .social-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent);
    background: var(--accent-glow);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .social-btn.xhs:hover {
    border-color: #ff6b6b;
    background: rgba(255, 107, 107, 0.1);
  }

  .social-btn.zhihu:hover {
    border-color: #0084ff;
    background: rgba(0, 132, 255, 0.1);
  }

  .social-btn.bilibili:hover {
    border-color: #00a1d6;
    background: rgba(0, 161, 214, 0.1);
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>