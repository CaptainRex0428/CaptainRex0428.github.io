---
import Base from '@/layouts/Base.astro';
import { useTranslations, getLocaleFromUrl } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Base title={t.about.title}>
  <section class="about section">
    <div class="about-background">
      <img src="/myphoto.jpg" alt="" class="about-photo" loading="lazy" />
    </div>
    <div class="container">
      <div class="about-header animate-slide-up" data-reveal>
        <h1 class="about-title">{t.about.title}</h1>
        <p class="about-intro">{t.about.intro}</p>
      </div>

      <div class="about-grid">
        <div class="about-card card" data-reveal>
          <h2 class="card-title">{t.about.skills}</h2>
          <div class="skills-grid">
            <div class="skill-item" data-reveal data-reveal-delay="0">
              <span class="skill-icon">🎮</span>
              <h3>{t.about.skillsList.gamedev}</h3>
              <p class="skill-detail">{t.about.skillsDetail.gamedev}</p>
            </div>
            <div class="skill-item" data-reveal data-reveal-delay="100">
              <span class="skill-icon">🛠️</span>
              <h3>{t.about.skillsList.dcc}</h3>
              <p class="skill-detail">{t.about.skillsDetail.dcc}</p>
            </div>
            <div class="skill-item" data-reveal data-reveal-delay="200">
              <span class="skill-icon">🎬</span>
              <h3>{t.about.skillsList.vfx}</h3>
              <p class="skill-detail">{t.about.skillsDetail.vfx}</p>
            </div>
            <div class="skill-item" data-reveal data-reveal-delay="300">
              <span class="skill-icon">📚</span>
              <h3>{t.about.skillsList.education}</h3>
              <p class="skill-detail">{t.about.skillsDetail.education}</p>
            </div>
          </div>
        </div>

        <div class="about-card card social-card" data-reveal>
          <h2 class="card-title">社交平台</h2>
          <div class="social-buttons">
            <div class="social-row">
              <img src="/icons/zhihu.png" alt="知乎" class="social-icon" />
              <div class="social-btns">
                <a href="https://www.zhihu.com/people/turing-digiart" target="_blank" rel="noopener" class="social-btn zhihu">
                  <span>图灵技术手记</span>
                </a>
              </div>
            </div>
            <div class="social-row">
              <img src="/icons/xiaohongshu.png" alt="小红书" class="social-icon" />
              <div class="social-btns">
                <a href="https://www.xiaohongshu.com/user/profile/697ed5bd00000000210136e2" target="_blank" rel="noopener" class="social-btn xhs">
                  <span>图灵数字艺术</span>
                </a>
                <a href="https://www.xiaohongshu.com/user/profile/6709d2da000000001d03100c" target="_blank" rel="noopener" class="social-btn xhs">
                  <span>图灵数字艺术技术手记</span>
                </a>
              </div>
            </div>
            <div class="social-row">
              <img src="/icons/bilibili.png" alt="B站" class="social-icon" />
              <div class="social-btns">
                <a href="https://space.bilibili.com/504030884" target="_blank" rel="noopener" class="social-btn bilibili">
                  <span>图灵数字艺术RestArt</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .about {
    position: relative;
  }

  .about-background {
    position: absolute;
    top: 0;
    right: 0;
    width: 45%;
    height: 50%;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    opacity: 0.6;
    filter: blur(2px);
    /* 使用 CSS 变量来实现边缘渐变融合 */
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  .about-background::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--bg-base) 0%, transparent 70%),
                linear-gradient(to top, var(--bg-base) 0%, transparent 70%);
    z-index: 1;
    pointer-events: none;
  }

  .about .container {
    position: relative;
    z-index: 1;
  }

  .about-header {
    margin-bottom: var(--space-12);
    max-width: 700px;
  }

  .about-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .about-intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.8;
    white-space: pre-line;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-6);
  }

  .about-card {
    padding: var(--space-8);
  }

  .card-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .skill-item {
    padding: var(--space-6);
    background: var(--bg-base);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .skill-icon {
    font-size: var(--text-3xl);
    display: block;
    margin-bottom: var(--space-3);
  }

  .skill-item h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
    font-weight: 600;
  }

  .skill-detail {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
    white-space: pre-line;
    margin: 0;
  }

  .skill-item:hover {
    background: var(--accent-glow);
    transform: translateY(-2px);
  }

  .skill-icon {
    font-size: var(--text-2xl);
    display: block;
    margin-bottom: var(--space-3);
  }

  .skill-item h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .skill-item p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  .social-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .social-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .social-icon {
    width: auto;
    height: 24px;
    flex-shrink: 0;
  }

  .social-btns {
    display: flex;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
  }

  .social-row .social-btn {
    flex: 1;
    max-width: none;
    justify-content: center;
    min-width: 0;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-base);
    box-shadow: 0 0 8px rgba(74, 74, 74, 0.2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .social-btn.xhs {
    font-size: var(--text-xs);
    white-space: nowrap;
    text-align: center;
    line-height: 1.4;
    padding: var(--space-2) var(--space-2);
  }

  .social-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent);
    background: var(--accent-glow);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .social-btn.xhs:hover {
    border-color: #ff6b6b;
    background: rgba(255, 107, 107, 0.1);
  }

  .social-btn.zhihu:hover {
    border-color: #0084ff;
    background: rgba(0, 132, 255, 0.1);
  }

  .social-btn.bilibili:hover {
    border-color: #00a1d6;
    background: rgba(0, 161, 214, 0.1);
  }

  @media (max-width: 1024px) {
    .about-background {
      display: none;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>