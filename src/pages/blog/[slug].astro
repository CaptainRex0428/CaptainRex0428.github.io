---
import Base from '@/layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations, getLocaleFromUrl } from '@/i18n';
import { formatDate } from '@/utils/formatDate';
import { getHeroImage } from '@/utils/heroImage';
import { getContentSlug } from '@/utils/contentSlug';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: getContentSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// 获取所有系列
const allSeries = await getCollection('blogSeries');

// 查找当前文章属于哪些系列
const belongingSeries = allSeries.filter(series =>
  series.data.items.some(item => {
    const itemSlug = typeof item === 'string' ? item : item.slug;
    return itemSlug === post.slug || itemSlug === post.id;
  })
);

const categories = {
  frontend: '前端技术',
  graphics: '图形学',
  tools: '工具分享',
  essay: '随笔'
};
const heroImage = getHeroImage(post);
---

<Base title={post.data.title}>
  <article class="blog-post">
    <header class="post-header" data-reveal>
      {heroImage && (
        <div class="post-hero">
          <img
            src={heroImage}
            alt={post.data.title}
            class="hero-image"
            width="1200"
            height="630"
          />
        </div>
      )}

      <div class="container">
        <div class="post-meta">
          <span class="post-category">{categories[post.data.category]}</span>
          <time class="post-date">
            {formatDate(post.data.date)}
          </time>
          {post.data.readTime && (
            <span class="post-read-time">· {post.data.readTime} 分钟阅读</span>
          )}
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>

        {belongingSeries.length > 0 && (
          <div class="post-series">
            {belongingSeries.map(series => (
              <a href={`/${locale === 'en' ? 'en/' : ''}blog/series/${getContentSlug(series)}`} class="series-tag">
                合集: {series.data.title}
              </a>
            ))}
          </div>
        )}

        {post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map(tag => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="post-content">
      <div class="container container-narrow">
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    <footer class="post-footer">
      <div class="container">
        {belongingSeries.length > 0 && (
          <div class="post-series-footer">
            <span class="series-label">本文属于合集：</span>
            {belongingSeries.map(series => (
              <a href={`/${locale === 'en' ? 'en/' : ''}blog/series/${getContentSlug(series)}`} class="series-link">
                {series.data.title}
              </a>
            ))}
          </div>
        )}
        <a href={`/${locale === 'en' ? 'en/' : ''}blog`} class="back-link">
          ← 返回博客列表
        </a>
      </div>
    </footer>
  </article>
</Base>

<style>
  .blog-post {
    min-height: 100vh;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .container-narrow {
    max-width: 97.5ch;
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .post-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--bg-border);
  }

  .post-hero {
    width: 100%;
    margin-bottom: var(--space-8);
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .post-category {
    padding: var(--space-1) var(--space-3);
    background: var(--accent-glow);
    color: var(--accent);
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .post-date {
    color: var(--text-secondary);
  }

  .post-read-time {
    color: var(--text-muted);
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .post-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }

  .post-series {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .series-tag {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .series-tag:hover {
    background: var(--accent);
    color: var(--bg-base);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    background: var(--bg-base);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-sm);
  }

  .post-content {
    margin-bottom: var(--space-24);
  }

  .prose :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .prose :global(p) {
    font-size: 1.3rem;
    line-height: 1.8;
    margin-bottom: var(--space-6);
    color: var(--text-secondary);
  }

  .prose :global(code) {
    padding: 0.2em 0.4em;
    font-size: 0.9em;
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-sm);
    font-family: 'JetBrains Mono', monospace;
  }

  .prose :global(pre) {
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    overflow-x: auto;
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
  }

  .prose :global(pre code) {
    padding: 0;
    background: transparent;
    border: none;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin: var(--space-8) 0;
    border-radius: var(--radius-md);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
    color: var(--text-secondary);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
    line-height: 1.6;
  }

  .prose :global(blockquote) {
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-6);
    border-left: 4px solid var(--accent);
    background: var(--accent-glow);
    color: var(--text-secondary);
  }

  .post-footer {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--bg-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .back-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  .post-series-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
  }

  .series-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .series-link {
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
    padding: var(--space-1) var(--space-3);
    background: var(--accent-glow);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .series-link:hover {
    background: var(--accent);
    color: var(--bg-base);
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: var(--text-2xl);
    }

    .post-hero {
      margin-bottom: var(--space-6);
    }
  }
</style>
