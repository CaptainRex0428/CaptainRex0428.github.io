---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocaleFromUrl } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter(post => post.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = ['frontend', 'graphics', 'tools', 'essay'];
const categoryNames: Record<string, string> = {
  frontend: '全部',
  graphics: '图形学',
  tools: '工具',
  essay: '随笔'
};
---

<Base title={t.blog.title}>
  <section class="blog-page section">
    <div class="container">
      <div class="page-header animate-slide-up">
        <h1 class="page-title">{t.blog.title}</h1>
        <p class="page-subtitle">{t.blog.subtitle}</p>
      </div>

      <div class="filters">
        <a href="/blog" class="filter active">全部</a>
        {categories.map(cat => (
          <a href={`/blog/${cat}`} class="filter">{t.categories[cat as keyof typeof t.categories]}</a>
        ))}
      </div>

      {publishedPosts.length > 0 ? (
        <div class="grid grid-2">
          {publishedPosts.map(post => (
            <Card
              href={`/blog/${post.slug}`}
              badge={post.data.category}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>{t.blog.empty}</p>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .filters {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .filter {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .filter:hover,
  .filter.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-glow);
  }
</style>