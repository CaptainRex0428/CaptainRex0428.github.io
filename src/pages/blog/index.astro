---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import PostListItem from '@/components/PostListItem.astro';
import SeriesCard from '@/components/SeriesCard.astro';
import DynamicTagFilter from '@/components/DynamicTagFilter.astro';
import ViewToggle from '@/components/ViewToggle.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocaleFromUrl } from '@/i18n';
import { formatDateShort } from '@/utils/formatDate';
import { getStandalonePosts } from '@/utils/tagHelpers';
import { getHeroImage } from '@/utils/heroImage';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Get current view mode
const currentView = Astro.url.searchParams.get('view') || 'grid';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter(post => post.data.published);

// 修复 slug 生成问题（如果 slug 是 undefined，则从 id 生成）
const postsWithFixedSlugs = publishedPosts.map(post => {
  if (!post.slug && post.id) {
    // 从 id 生成 slug
    let slug = post.id.replace(/\.(md|mdx)$/, '');
    if (slug.endsWith('/index')) {
      slug = slug.replace('/index', '');
    }
    return { ...post, slug };
  }
  return post;
});

// Get series
const allSeries = await getCollection('blogSeries');

// Get standalone posts (not in series)
const standalonePosts = getStandalonePosts(postsWithFixedSlugs)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Sort series by order and date
const sortedSeries = allSeries.sort((a, b) => {
  if (a.data.order !== b.data.order) return b.data.order - a.data.order;
  return (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0);
});

// 动态计算合集的标签（使用合集自己的独立标签）
const seriesTags = [...new Set(sortedSeries.flatMap(series => series.data.tags || []))];

// 动态计算文章的标签
const postsTags = [...new Set(standalonePosts.flatMap(post => post.data.tags || []))];

const categories = ['frontend', 'graphics', 'tools', 'essay'];
const categoryNames: Record<string, string> = {
  frontend: t.categories?.['frontend'] || '前端',
  graphics: t.categories?.['graphics'] || '图形学',
  tools: t.categories?.['tools'] || '工具',
  essay: t.categories?.['essay'] || '随笔',
};
---

<Base title={t.blog.title}>
  <section class="blog-page section">
    <div class="container">
      <div class="page-header animate-slide-up">
        <h1 class="page-title">{t.blog.title}</h1>
        <p class="page-subtitle">{t.blog.subtitle}</p>
      </div>

      <!-- Series Section -->
      {sortedSeries.length > 0 && (
        <section class="series-section">
          <h2 class="section-title">合集</h2>
          <!-- 合集动态标签过滤器 -->
          {seriesTags.length > 0 && (
            <DynamicTagFilter
              id="blog-series-filter"
              labels={seriesTags}
              targetType="series"
              maxVisible={8}
            />
          )}
          <div class="series-list">
            {sortedSeries.map(series => (
              <div class="content-item"
                   data-content-type="series"
                   data-tags={(series.data.tags || []).join(',')}>
                <SeriesCard
                  href={`/blog/series/${series.slug}`}
                  title={series.data.title}
                  description={series.data.description}
                  cover={series.data.coverImage}
                  tags={series.data.tags || []}
                  itemCount={series.data.items.length}
                />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Standalone Posts -->
      <section class="posts-section">
        <div class="section-header">
          <h2 class="section-title">文章</h2>
          <ViewToggle />
        </div>
        <!-- 文章动态标签过滤器 -->
        {postsTags.length > 0 && (
          <DynamicTagFilter
            id="blog-posts-filter"
            labels={postsTags}
            targetType="posts"
            maxVisible={8}
          />
        )}
        {standalonePosts.length > 0 ? (
          <div class="grid-auto" id="posts-container" data-content-type="posts">
            {standalonePosts.map(post => {
              const heroImg = getHeroImage(post);
              return (
                <div class={`content-item${heroImg ? ' has-cover' : ''}`}
                     data-content-type="posts"
                     data-tags={(post.data.tags || []).join(',')}>
                  <div class="grid-view-component">
                    <Card
                      href={`/blog/${post.slug}`}
                      title={post.data.title}
                      description={post.data.description}
                      cover={heroImg}
                      tags={post.data.tags}
                      date={formatDateShort(post.data.date)}
                    />
                  </div>
                  <div class="list-view-component">
                    <PostListItem
                      href={`/blog/${post.slug}`}
                      title={post.data.title}
                      description={post.data.description}
                      cover={heroImg}
                      tags={post.data.tags}
                      date={formatDateShort(post.data.date)}
                    />
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-state">
            <p>{t.blog.empty}</p>
          </div>
        )}
      </section>
    </div>
  </section>
</Base>

<style>
  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .filters {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .filter {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .filter:hover,
  .filter.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-glow);
  }

  .series-section,
  .posts-section,
  .tags-section {
    margin-bottom: var(--space-12);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .global-tags {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--bg-border);
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-6);
    color: var(--text-primary);
  }

  .series-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* 列表视图的内容��样式 */
  .posts-list .content-item {
    padding: 0;
    background: transparent;
    border: none;
  }

  /* 视图切换：网格视图显示 Card，隐藏 PostListItem */
  .grid-auto .grid-view-component {
    display: block;
  }
  .grid-auto .list-view-component {
    display: none;
  }

  /* 视图切换：列表视图显示 PostListItem，隐藏 Card */
  .posts-list .grid-view-component {
    display: none;
  }
  .posts-list .list-view-component {
    display: block;
  }

  /* 隐藏状态：整个内容项隐藏 */
  .content-item.hidden {
    display: none !important;
  }

  /* 客户端过滤动画 */
  .content-item {
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .content-item.hidden {
    display: none;
  }

  .content-item.fade-in {
    animation: fadeIn var(--transition-base) ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>