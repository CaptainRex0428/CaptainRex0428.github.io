---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import { useTranslations, getLocaleFromUrl } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const categories = ['frontend', 'graphics', 'tools', 'essay'];
---

<Base title={t.blog.title}>
  <section class="blog-page section">
    <div class="container">
      <div class="page-header animate-slide-up">
        <h1 class="page-title">{t.blog.title}</h1>
        <p class="page-subtitle">{t.blog.subtitle}</p>
      </div>

      <div class="filters">
        <a href="/blog" class="filter active">全部</a>
        {categories.map(cat => (
          <a href={`/blog/${cat}`} class="filter">{t.categories[cat as keyof typeof t.categories]}</a>
        ))}
      </div>

      <div class="grid grid-2">
        <Card
          href="/blog/frontend"
          badge="frontend"
          title="Three.js 进阶：性能优化实战"
          description="深入探讨 Three.js 项目中的性能瓶颈及优化策略，包括几何体合并、纹理压缩等技术。"
          date="2026-01-15"
        />
        <Card
          href="/blog/graphics"
          badge="graphics"
          title="WebGL 着色器入门指南"
          description="从零开始学习 GLSL 着色器编程，理解顶点着色器和片元着色器的工作原理。"
          date="2026-01-08"
        />
        <Card
          href="/blog/tools"
          badge="tools"
          title="VS Code 插件推荐：提升前端开发效率"
          description="分享几款我常用的高效 VS Code 插件，从代码补全到调试工具全覆盖。"
          date="2025-12-20"
        />
        <Card
          href="/blog/essay"
          badge="essay"
          title="2025 年前端技术趋势回顾"
          description="回顾这一年前端领域的重要变化，聊聊我对这些趋势的看法。"
          date="2025-12-28"
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .filters {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .filter {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .filter:hover,
  .filter.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-glow);
  }
</style>