---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import { getCollection } from 'astro:content';
import { getSeriesPosts } from '@/utils/tagHelpers';
import { formatDateShort } from '@/utils/formatDate';

export async function getStaticPaths() {
  const allSeries = await getCollection('blogSeries');
  return allSeries.map(series => ({
    params: { slug: series.slug },
    props: { series },
  }));
}

const { series } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => data.published !== false);
const seriesPosts = getSeriesPosts(series.data.items, allPosts);
---

<Base title={series.data.title}>
  <section class="series-detail section">
    <div class="container">
      <!-- Series Header -->
      <header class="series-header">
        <img src={series.data.coverImage} alt={series.data.title} class="series-cover" />
        <div class="series-info">
          <h1 class="series-title">{series.data.title}</h1>
          <p class="series-description">{series.data.description}</p>
          <div class="series-meta">
            <span class="series-count">{seriesPosts.length} 篇文章</span>
            {series.data.date && (
              <time class="series-date">{formatDateShort(series.data.date)}</time>
            )}
          </div>
        </div>
      </header>

      <!-- Series Posts -->
      <section class="series-posts">
        <h2 class="section-title">文章列表</h2>
        {seriesPosts.length > 0 ? (
          <div class="posts-grid">
            {seriesPosts.map((post, index) => (
              <Card
                href={`/blog/${post.slug}`}
                badge={`第 ${index + 1} 篇`}
                badgeText={`第 ${index + 1} 篇`}
                title={post.data.title}
                description={post.data.description}
                date={formatDateShort(post.data.date)}
              />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>该合集暂无文章</p>
          </div>
        )}
      </section>
    </div>
  </section>
</Base>

<style>
  .series-header {
    margin-bottom: var(--space-16);
    text-align: center;
  }

  .series-cover {
    width: 100%;
    max-width: 800px;
    aspect-ratio: 16 / 9;
    margin: 0 auto var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-base);
  }

  .series-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .series-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .series-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }

  .series-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-6);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-bottom: var(--space-8);
    color: var(--text-primary);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }
</style>