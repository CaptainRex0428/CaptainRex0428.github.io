    <div class="container">
      <div class="cta-card card">
        <h2 class="cta-title">Let's Connect</h2>
        <p class="cta-desc">Find me on these platforms</p>
        <div class="social-links">
          <a href="https://www.zhihu.com/people/turing-digiart" target="_blank" rel="noopener" class="social-btn">
