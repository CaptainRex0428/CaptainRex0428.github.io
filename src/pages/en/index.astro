---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { useTranslations, getLocaleFromUrl } from '../../i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Base title={t.hero.title}>
  <!-- Hero Section -->
  <section class="hero section">
    <div class="container">
      <div class="hero-content animate-slide-up">
        <h1 class="hero-title">
          {t.hero.title} <span class="accent">CaptainRex</span>
        </h1>
        <div class="hero-tags">
          {(Array.isArray(t.hero.subtitle) ? t.hero.subtitle : [t.hero.subtitle]).map((tag: string) => (
            <span class="hero-tag">{tag}</span>
          ))}
        </div>
        <div class="hero-actions">
          <a href="/en/works" class="btn btn-primary">{t.hero.cta}</a>
          <a href="/en/blog" class="btn btn-secondary">Read Blog</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="glow-orb"></div>
        <div class="grid-lines"></div>
      </div>
    </div>
  </section>

  <!-- Works Preview -->
  <section class="works-preview section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{t.works.title}</h2>
        <a href="/en/works" class="link">{t.works.all} &rarr;</a>
      </div>

      <div class="grid grid-3">
        <Card
          href="/en/works/frontend"
          badge="frontend"
          title="WebGL Particle System"
          description="Interactive particle effects built with Three.js, supporting custom parameters and real-time rendering."
        />
        <Card
          href="/en/works/3d"
          badge="3d"
          title="3D Product Showcase"
          description="WebGL-based 3D product display with multi-angle viewing and material switching."
        />
        <Card
          href="/en/works/design-tools"
          badge="design-tools"
          title="Design Tools Collection"
          description="A set of tools for improving design efficiency, including color conversion and gradient generation."
        />
      </div>
    </div>
  </section>

  <!-- Blog Preview -->
  <section class="blog-preview section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{t.blog.title}</h2>
        <a href="/en/blog" class="link">{t.blog.all} &rarr;</a>
      </div>

      <div class="grid grid-2">
        <Card
          href="/en/blog/frontend"
          badge="frontend"
          title="Three.js Advanced: Performance Optimization"
          description="Deep dive into Three.js performance bottlenecks and optimization strategies."
          date="2026-01-15"
        />
        <Card
          href="/en/blog/graphics"
          badge="graphics"
          title="WebGL Shaders: A Beginner's Guide"
          description="Learn GLSL shader programming from scratch, understanding vertex and fragment shaders."
          date="2026-01-08"
        />
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="cta-section section">
    <div class="container">
      <div class="cta-card card">
        <h2 class="cta-title">Let's Connect</h2>
        <p class="cta-desc">Find me on these platforms</p>
        <div class="social-links">
          <a href="https://www.zhihu.com/people/turing-digiart" target="_blank" rel="noopener" class="social-btn">
            Zhihu
          </a>
          <a href="https://www.xiaohongshu.com/user/profile/697ed5bd00000000210136e2" target="_blank" rel="noopener" class="social-btn">
            Xiaohongshu
          </a>
          <a href="https://space.bilibili.com/504030884" target="_blank" rel="noopener" class="social-btn">
            图灵数字艺术RestArt
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-badge {
    margin-bottom: var(--space-4);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .accent {
    color: var(--accent);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .hero-desc {
    font-size: var(--text-base);
    color: var(--text-muted);
    max-width: 50ch;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glow-orb {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow-strong), transparent 70%);
    filter: blur(40px);
    animation: pulse 4s ease-in-out infinite;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--bg-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--bg-border) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.3;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  .cta-card {
    text-align: center;
    padding: var(--space-16);
    background: linear-gradient(135deg, rgba(19, 19, 26, 0.9), rgba(19, 19, 26, 0.6));
  }

  .cta-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .cta-desc {
    color: var(--text-secondary);
    margin-bottom: var(--space-8);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .social-btn {
    padding: var(--space-3) var(--space-6);
    background: var(--bg-base);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  @media (max-width: 1024px) {
    .hero .container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-visual {
      display: none;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 60vh;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>