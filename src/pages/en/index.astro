---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { useTranslations, getLocaleFromUrl } from '../../i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Base title={t.hero.title}>
  <!-- Hero Section -->
  <section class="hero section">
    <div class="container">
      <div class="hero-content animate-slide-up">
        <h1 class="hero-title">
          {t.hero.title} <span class="accent">CaptainRex</span>
        </h1>
        <div class="hero-tags">
          {(Array.isArray(t.hero.subtitle) ? t.hero.subtitle : [t.hero.subtitle]).map((tag: string) => (
            <span class="hero-tag">{tag}</span>
          ))}
        </div>
        <div class="hero-actions">
          <a href="/en/works" class="btn btn-primary">{t.hero.cta}</a>
          <a href="/en/blog" class="btn btn-secondary">Read Blog</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="glow-orb"></div>
        <div class="grid-lines"></div>
      </div>
    </div>
  </section>

  <!-- Works Preview -->
  <section class="works-preview section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{t.works.title}</h2>
        <a href="/en/works" class="link">{t.works.all} &rarr;</a>
      </div>

      <div class="grid grid-3">
        <Card
          href="/en/works/frontend"
          badge="frontend"
          title="WebGL Particle System"
          description="Interactive particle effects built with Three.js, supporting custom parameters and real-time rendering."
        />
        <Card
          href="/en/works/3d"
          badge="3d"
          title="3D Product Showcase"
          description="WebGL-based 3D product display with multi-angle viewing and material switching."
        />
        <Card
          href="/en/works/design-tools"
          badge="design-tools"
          title="Design Tools Collection"
          description="A set of tools for improving design efficiency, including color conversion and gradient generation."
        />
      </div>
    </div>
  </section>

  <!-- Blog Preview -->
  <section class="blog-preview section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{t.blog.title}</h2>
        <a href="/en/blog" class="link">{t.blog.all} &rarr;</a>
      </div>

      <div class="grid grid-2">
        <Card
          href="/en/blog/frontend"
          badge="frontend"
          title="Three.js Advanced: Performance Optimization"
          description="Deep dive into Three.js performance bottlenecks and optimization strategies."
          date="2026-01-15"
        />
        <Card
          href="/en/blog/graphics"
          badge="graphics"
          title="WebGL Shaders: A Beginner's Guide"
          description="Learn GLSL shader programming from scratch, understanding vertex and fragment shaders."
          date="2026-01-08"
        />
      </div>
    </div>
  </section>

<script>
  document.addEventListener('click', (e) => {
    const dropdown = e.target.closest('.social-dropdown');
    document.querySelectorAll('.social-dropdown.open').forEach(d => {
      if (d !== dropdown) d.classList.remove('open');
    });
    if (dropdown) {
      dropdown.classList.toggle('open');
    }
  });
</script>

  <!-- Contact CTA -->
