---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocaleFromUrl } from '@/i18n';
import { formatDateShort } from '@/utils/formatDate';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// 获取最新的 3 篇博客（按日期降序）
const allPosts = await getCollection('blog', ({ data }) => {
  return data.published !== false;
});
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// 获取最新的 3 个作品（按 order 和日期排序）
const allWorks = await getCollection('works');
const latestWorks = allWorks
  .sort((a, b) => {
    if (a.data.order !== b.data.order) {
      return b.data.order - a.data.order;
    }
    return (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0);
  })
  .slice(0, 3);
---

<Base title={t.hero.title}>
  <!-- Hero Section -->
  <section class="hero section">
    <div class="container">
      <div class="hero-content animate-slide-up">
        <h1 class="hero-title">
          {t.hero.title}
        </h1>
        <div class="hero-logo-container">
          <img src="/rex.png" alt="CaptainRex" class="hero-logo" />
        </div>
        <div class="hero-tags">
          {(Array.isArray(t.hero.subtitle) ? t.hero.subtitle : [t.hero.subtitle]).map((tag: string, i: number) => (
            <span class="hero-tag" data-reveal data-reveal-delay={String(300 + i * 100)}>{tag}</span>
          ))}
        </div>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">阅读博客</a>
          <a href="/works" class="btn btn-secondary">{t.hero.cta}</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="glow-orb"></div>
        <div class="grid-lines"></div>
      </div>
    </div>
  </section>

  <!-- Works Preview -->
  <section class="works-preview section">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2 class="section-title">{t.works.title}</h2>
        <a href="/works" class="link">{t.works.all} &rarr;</a>
      </div>

      <div class="grid grid-3">
        {latestWorks.map((work, i) => (
          <div data-reveal data-reveal-delay={String((i + 1) * 100)}>
            <Card
              href={`/works/${work.slug}`}
              badge={work.data.category}
              title={work.data.title}
              description={work.data.description}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Preview -->
  <section class="blog-preview section">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2 class="section-title">{t.blog.title}</h2>
        <a href="/blog" class="link">{t.blog.all} &rarr;</a>
      </div>

      <div class="grid grid-2">
        {latestPosts.map((post, i) => (
          <div data-reveal data-reveal-delay={String((i + 1) * 100)}>
            <Card
              href={`/blog/${post.slug}`}
              badge={post.data.category}
              title={post.data.title}
              description={post.data.description}
              date={formatDateShort(post.data.date)}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

<script>
  document.addEventListener('click', (e) => {
    const dropdown = e.target.closest('.social-dropdown');
    document.querySelectorAll('.social-dropdown.open').forEach(d => {
      if (d !== dropdown) d.classList.remove('open');
    });
    if (dropdown) {
      dropdown.classList.toggle('open');
    }
  });
</script>

  <!-- Contact CTA -->
  <section class="cta-section section">
    <div class="container">
      <div class="cta-card card" data-reveal>
        <h2 class="cta-title">想聊聊？</h2>
        <p class="cta-desc">可以在以下平台找到我</p>
        <div class="social-links">
          <a href="https://www.zhihu.com/people/turing-digiart" target="_blank" rel="noopener" class="social-btn" title="知乎">
            <img src="/icons/zhihu.png" alt="知乎" class="social-btn-icon" />
          </a>
          <div class="social-dropdown">
            <button class="social-btn social-dropdown-btn" aria-expanded="false" aria-haspopup="true" title="小红书">
              <img src="/icons/xiaohongshu.png" alt="小红书" class="social-btn-icon" />
              <svg class="dropdown-arrow" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
            </button>
            <div class="social-dropdown-menu">
              <a href="https://www.xiaohongshu.com/user/profile/697ed5bd00000000210136e2" target="_blank" rel="noopener" class="dropdown-item">
                {t.social.xiaohongshuName}
              </a>
              <a href="https://www.xiaohongshu.com/user/profile/6709d2da000000001d03100c" target="_blank" rel="noopener" class="dropdown-item">
                {t.social.xiaohongshuName2}
              </a>
            </div>
          </div>
          <a href="https://space.bilibili.com/504030884" target="_blank" rel="noopener" class="social-btn" title="B站">
            <img src="/icons/bilibili.png" alt="B站" class="social-btn-icon" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }


  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-8);
  }

  .hero-logo-container {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-8);
  }

  .hero-logo {
    height: 200px;
    width: auto;
    filter: drop-shadow(0 0 20px rgba(255, 140, 0, 0.3));
  }

  .accent {
    color: var(--accent);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .hero-tag {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    box-shadow: 0 0 8px rgba(74, 74, 74, 0.3);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glow-orb {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow-strong), transparent 70%);
    filter: blur(40px);
    animation: pulse 4s ease-in-out infinite, rotate 30s linear infinite;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--bg-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--bg-border) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.3;
  }

  /* Section Header */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  /* CTA Section */
  .cta-card {
    text-align: center;
    padding: var(--space-16);
    background: linear-gradient(135deg, rgba(19, 19, 26, 0.9), rgba(19, 19, 26, 0.6));
  }

  .cta-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .cta-desc {
    color: var(--text-secondary);
    margin-bottom: var(--space-8);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .social-btn {
    padding: 8px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-base);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .social-btn .social-btn-icon {
    height: 32px;
    width: auto;
  }

  .social-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  .social-dropdown {
    position: relative;
    display: inline-flex;
  }

  .social-dropdown-btn {
    cursor: pointer;
    gap: var(--space-2);
  }

  .dropdown-arrow {
    transition: transform 0.2s ease;
  }

  .social-dropdown.open .dropdown-arrow {
    transform: rotate(180deg);
  }

  .social-dropdown-menu {
    position: absolute;
    bottom: calc(100% + var(--space-2));
    left: 50%;
    transform: translateX(-50%);
    min-width: 180px;
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    display: none;
    z-index: 100;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .social-dropdown.open .social-dropdown-menu {
    display: block;
    animation: fadeIn 0.15s ease;
  }

  .dropdown-item {
    display: block;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .dropdown-item:hover {
    background: var(--accent-glow);
    color: var(--text-primary);
    border-color: var(--accent);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.05); }
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 1024px) {
    .hero .container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-visual {
      display: none;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 60vh;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>