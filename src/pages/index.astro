---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import { useTranslations, getLocaleFromUrl } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Base title={t.hero.title}>
  <!-- Hero Section -->
  <section class="hero section">
    <div class="container">
      <div class="hero-content animate-slide-up">
        <h1 class="hero-title">
          {t.hero.title} <span class="accent">CaptainRex</span>
        </h1>
        <div class="hero-tags">
          {(Array.isArray(t.hero.subtitle) ? t.hero.subtitle : [t.hero.subtitle]).map((tag: string) => (
            <span class="hero-tag">{tag}</span>
          ))}
        </div>
        <div class="hero-actions">
          <a href="/works" class="btn btn-primary">{t.hero.cta}</a>
          <a href="/blog" class="btn btn-secondary">阅读博客</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="glow-orb"></div>
        <div class="grid-lines"></div>
      </div>
    </div>
  </section>

  <!-- Works Preview -->
  <section class="works-preview section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{t.works.title}</h2>
        <a href="/works" class="link">{t.works.all} &rarr;</a>
      </div>

      <div class="grid grid-3">
        <!-- 示例卡片，将替换为真实数据 -->
        <Card
          href="/works/frontend"
          badge="frontend"
          title="WebGL 粒子系统"
          description="使用 Three.js 构建的交互式粒子效果，支持自定义参数和实时渲染。"
        />
        <Card
          href="/works/3d"
          badge="3d"
          title="3D 产品展示台"
          description="基于 WebGL 的 3D 产品展示方案，支持多角度查看和材质切换。"
        />
        <Card
          href="/works/design-tools"
          badge="design-tools"
          title="设计工具合集"
          description="一系列提升设计效率的小工具，包含颜色转换、渐变生成等功能。"
        />
      </div>
    </div>
  </section>

  <!-- Blog Preview -->
  <section class="blog-preview section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{t.blog.title}</h2>
        <a href="/blog" class="link">{t.blog.all} &rarr;</a>
      </div>

      <div class="grid grid-2">
        <Card
          href="/blog/frontend"
          badge="frontend"
          title="Three.js 进阶：性能优化实战"
          description="深入探讨 Three.js 项目中的性能瓶颈及优化策略，包括几何体合并、纹理压缩等技术。"
          date="2026-01-15"
        />
        <Card
          href="/blog/graphics"
          badge="graphics"
          title="WebGL 着色器入门指南"
          description="从零开始学习 GLSL 着色器编程，理解顶点着色器和片元着色器的工作原理。"
          date="2026-01-08"
        />
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="cta-section section">
    <div class="container">
      <div class="cta-card card">
        <h2 class="cta-title">想聊聊？</h2>
        <p class="cta-desc">可以在以下平台找到我</p>
        <div class="social-links">
          <a href="https://www.zhihu.com/people/turing-digiart" target="_blank" rel="noopener" class="social-btn">
            知乎
          </a>
          <a href="https://www.xiaohongshu.com/user/profile/697ed5bd00000000210136e2" target="_blank" rel="noopener" class="social-btn">
            小红书
          </a>
          <a href="https://space.bilibili.com/504030884" target="_blank" rel="noopener" class="social-btn">
            图灵数字艺术RestArt
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }


  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .accent {
    color: var(--accent);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .hero-tag {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    box-shadow: 0 0 8px rgba(74, 74, 74, 0.3);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glow-orb {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow-strong), transparent 70%);
    filter: blur(40px);
    animation: pulse 4s ease-in-out infinite;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--bg-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--bg-border) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.3;
  }

  /* Section Header */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  /* CTA Section */
  .cta-card {
    text-align: center;
    padding: var(--space-16);
    background: linear-gradient(135deg, rgba(19, 19, 26, 0.9), rgba(19, 19, 26, 0.6));
  }

  .cta-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .cta-desc {
    color: var(--text-secondary);
    margin-bottom: var(--space-8);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .social-btn {
    padding: var(--space-3) var(--space-6);
    background: var(--bg-base);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  @media (max-width: 1024px) {
    .hero .container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-visual {
      display: none;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 60vh;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>