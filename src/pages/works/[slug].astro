---
import Base from '@/layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations, getLocaleFromUrl } from '@/i18n';
import { getHeroImage } from '@/utils/heroImage';
import { getContentSlug } from '@/utils/contentSlug';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map(work => ({
    params: { slug: getContentSlug(work) },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const heroImage = getHeroImage(work);

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// 获取所有系列
const allSeries = await getCollection('workSeries');

// 查找当前作品属于哪些系列
const belongingSeries = allSeries.filter(series =>
  series.data.items.some(item => {
    const itemSlug = typeof item === 'string' ? item : item.slug;
    return itemSlug === work.slug || itemSlug === work.id;
  })
);

const categories = {
  frontend: '前端项目',
  '3d': '3D 作品',
  'design-tools': '设计工具',
  other: '其他'
};
---

<Base title={work.data.title}>
  <article class="work-post">
    <header class="work-header">
      {heroImage && (
        <div class="work-hero">
          <img
            src={heroImage}
            alt={work.data.title}
            class="hero-image"
          />
        </div>
      )}

      <div class="container">
        <div class="work-meta">
          <span class="work-category">{categories[work.data.category]}</span>
          {work.data.date && (
            <time class="work-date">
              {work.data.date.toLocaleDateString('zh-CN')}
            </time>
          )}
        </div>
        <h1 class="work-title">{work.data.title}</h1>
        <p class="work-description">{work.data.description}</p>

        {belongingSeries.length > 0 && (
          <div class="work-series">
            {belongingSeries.map(series => (
              <a href={`/${locale === 'en' ? 'en/' : ''}works/series/${getContentSlug(series)}`} class="series-tag">
                合集: {series.data.title}
              </a>
            ))}
          </div>
        )}

        {work.data.tags.length > 0 && (
          <div class="work-tags">
            {work.data.tags.map(tag => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="work-content">
      <div class="container container-narrow">
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    <footer class="work-footer">
      <div class="container">
        {belongingSeries.length > 0 && (
          <div class="work-series-footer">
            <span class="series-label">本文属于合集：</span>
            {belongingSeries.map(series => (
              <a href={`/${locale === 'en' ? 'en/' : ''}works/series/${getContentSlug(series)}`} class="series-link">
                {series.data.title}
              </a>
            ))}
          </div>
        )}
        <div class="work-navigation">
          <a href={`/${locale === 'en' ? 'en/' : ''}works`} class="back-link">
            ← 返回作品列表
          </a>
        </div>
      </div>
    </footer>
  </article>
</Base>

<style>
  .work-post {
    min-height: 100vh;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .container-narrow {
    max-width: 97.5ch;
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .work-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--bg-border);
  }

  .work-hero {
    width: 100%;
    margin-bottom: var(--space-8);
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    flex-wrap: wrap;
  }

  .work-category {
    padding: var(--space-1) var(--space-3);
    background: var(--accent-glow);
    color: var(--accent);
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .work-date {
    color: var(--text-secondary);
  }

  .work-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .work-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }

  .work-series {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .series-tag {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .series-tag:hover {
    background: var(--accent);
    color: var(--bg-base);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    background: var(--bg-base);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-sm);
  }

  .work-content {
    margin-bottom: var(--space-24);
  }

  .prose :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .prose :global(p) {
    font-size: 1.3rem;
    line-height: 1.8;
    margin-bottom: var(--space-6);
    color: var(--text-secondary);
  }

  .prose :global(code) {
    padding: 0.2em 0.4em;
    font-size: 0.9em;
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-sm);
    font-family: 'JetBrains Mono', monospace;
  }

  .prose :global(pre) {
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    overflow-x: auto;
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
  }

  .prose :global(pre code) {
    padding: 0;
    background: transparent;
    border: none;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin: var(--space-8) 0;
    border-radius: var(--radius-md);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
    color: var(--text-secondary);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
    line-height: 1.6;
  }

  .prose :global(blockquote) {
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-6);
    border-left: 4px solid var(--accent);
    background: var(--accent-glow);
    color: var(--text-secondary);
  }

  .work-footer {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--bg-border);
  }

  .work-navigation {
    display: flex;
    justify-content: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .back-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  .work-series-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
  }

  .series-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .series-link {
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
    padding: var(--space-1) var(--space-3);
    background: var(--accent-glow);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .series-link:hover {
    background: var(--accent);
    color: var(--bg-base);
  }

  @media (max-width: 768px) {
    .work-title {
      font-size: var(--text-2xl);
    }

    .work-hero {
      margin-bottom: var(--space-6);
    }
  }
</style>
