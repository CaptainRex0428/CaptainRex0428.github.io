---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import PostListItem from '@/components/PostListItem.astro';
import SeriesCard from '@/components/SeriesCard.astro';
import DynamicTagFilter from '@/components/DynamicTagFilter.astro';
import ViewToggle from '@/components/ViewToggle.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocaleFromUrl } from '@/i18n';
import { getStandaloneWorks } from '@/utils/tagHelpers';
import { getHeroImage } from '@/utils/heroImage';
import { formatDateShort } from '@/utils/formatDate';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Get current view mode
const currentView = Astro.url.searchParams.get('view') || 'grid';

const allWorks = await getCollection('works');

// Get series
const allSeries = await getCollection('workSeries');

// Get standalone works (not in series)
const standaloneWorks = getStandaloneWorks(allWorks).sort((a, b) => {
  if (a.data.order !== b.data.order) return b.data.order - a.data.order;
  return (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0);
});

// Sort series by order and date
const sortedSeries = allSeries.sort((a, b) => {
  if (a.data.order !== b.data.order) return b.data.order - a.data.order;
  return (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0);
});

// 动态计算合集的标签（使用合集自己的独立标签）
const seriesTags = [...new Set(sortedSeries.flatMap(series => series.data.tags || []))];

// 动态计算作品的标签
const worksTags = [...new Set(standaloneWorks.flatMap(work => work.data.tags || []))];

const categories = ['frontend', '3d', 'design-tools', 'other'];
const categoryNames: Record<string, string> = {
  frontend: t.categories?.['frontend'] || '前端',
  '3d': t.categories?.['3d'] || '3D',
  'design-tools': t.categories?.['design-tools'] || '设计工具',
  other: t.categories?.['other'] || '其他',
};
---

<Base title={t.works.title}>
  <section class="works-page section">
    <div class="container">
      <div class="page-header animate-slide-up">
        <h1 class="page-title">{t.works.title}</h1>
        <p class="page-subtitle">{t.works.subtitle}</p>
      </div>

      <!-- Series Section -->
      {sortedSeries.length > 0 && (
        <section class="series-section">
          <h2 class="section-title">合集</h2>
          <!-- 合集动态标签过滤器 -->
          {seriesTags.length > 0 && (
            <DynamicTagFilter
              id="works-series-filter"
              labels={seriesTags}
              targetType="series"
              maxVisible={8}
            />
          )}
          <div class="series-list">
            {sortedSeries.map(series => (
              <div class="content-item"
                   data-content-type="series"
                   data-tags={(series.data.tags || []).join(',')}>
                <SeriesCard
                  href={`/works/series/${series.slug}`}
                  title={series.data.title}
                  description={series.data.description}
                  cover={series.data.coverImage}
                  tags={series.data.tags || []}
                  itemCount={series.data.items.length}
                />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Standalone Works -->
      <section class="works-section">
        <div class="section-header">
          <h2 class="section-title">作品</h2>
          <ViewToggle />
        </div>
        <!-- 作品动态标签过滤器 -->
        {worksTags.length > 0 && (
          <DynamicTagFilter
            id="works-items-filter"
            labels={worksTags}
            targetType="works"
            maxVisible={8}
          />
        )}
        {standaloneWorks.length > 0 ? (
          <div class="grid-auto" id="works-container" data-content-type="works">
            {standaloneWorks.map(work => {
              const heroImg = getHeroImage(work);
              return (
                <div class={`content-item${heroImg ? ' has-cover' : ''}`}
                     data-content-type="works"
                     data-tags={(work.data.tags || []).join(',')}>
                  <div class="grid-view-component">
                    <Card
                      href={`/works/${work.slug}`}
                      title={work.data.title}
                      description={work.data.description}
                      cover={heroImg}
                      tags={work.data.tags}
                      date={formatDateShort(work.data.date)}
                    />
                  </div>
                  <div class="list-view-component">
                    <PostListItem
                      href={`/works/${work.slug}`}
                      title={work.data.title}
                      description={work.data.description}
                      cover={heroImg}
                      tags={work.data.tags}
                      date={formatDateShort(work.data.date)}
                    />
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-state">
            <p>{t.works.empty}</p>
          </div>
        )}
      </section>
    </div>
  </section>
</Base>

<style>
  .grid-auto {
    align-items: start !important;
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .filters {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .filter {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .filter:hover,
  .filter.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-glow);
  }

  .series-section,
  .works-section {
    margin-bottom: var(--space-12);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .series-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .works-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* 列表视图的内容项样式 */
  .works-list .content-item {
    padding: 0;
    background: transparent;
    border: none;
  }

  /* 视图切换：网格视图显示 Card，隐藏 PostListItem */
  .grid-auto .grid-view-component {
    display: block;
  }
  .grid-auto .list-view-component {
    display: none;
  }

  /* 视图切换：列表视图显示 PostListItem，隐藏 Card */
  .works-list .grid-view-component {
    display: none;
  }
  .works-list .list-view-component {
    display: block;
  }

  /* 隐藏状态：整个内容项隐藏 */
  .content-item.hidden {
    display: none !important;
  }

  /* 客户端过滤动画 */
  .content-item {
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .content-item.hidden {
    display: none;
  }

  .content-item.fade-in {
    animation: fadeIn var(--transition-base) ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>