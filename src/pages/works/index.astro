---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocaleFromUrl } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const allWorks = await getCollection('works');
const sortedWorks = allWorks.sort((a, b) => {
  if (a.data.order !== b.data.order) {
    return b.data.order - a.data.order;
  }
  return (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0);
});

const categories = ['frontend', '3d', 'design-tools', 'other'];
---

<Base title={t.works.title}>
  <section class="works-page section">
    <div class="container">
      <div class="page-header animate-slide-up">
        <h1 class="page-title">{t.works.title}</h1>
        <p class="page-subtitle">{t.works.subtitle}</p>
      </div>

      <div class="filters">
        <a href="/works" class="filter active">全部</a>
        {categories.map(cat => (
          <a href={`/works/${cat}`} class="filter">{t.categories[cat as keyof typeof t.categories]}</a>
        ))}
      </div>

      {sortedWorks.length > 0 ? (
        <div class="grid grid-3">
          {sortedWorks.map(work => (
            <Card
              href={`/works/${work.slug}`}
              badge={work.data.category}
              title={work.data.title}
              description={work.data.description}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>{t.works.empty}</p>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .filters {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .filter {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .filter:hover,
  .filter.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-glow);
  }
</style>