---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import DynamicTagFilter from '@/components/DynamicTagFilter.astro';
import { getCollection } from 'astro:content';
import { getSeriesWorks } from '@/utils/tagHelpers';
import { getHeroImage } from '@/utils/heroImage';
import { getContentSlug } from '@/utils/contentSlug';

export async function getStaticPaths() {
  const allSeries = await getCollection('workSeries');
  return allSeries.map(series => ({
    params: { slug: getContentSlug(series) },
    props: { series },
  }));
}

const { series } = Astro.props;
const allWorks = await getCollection('works');
const seriesWorks = getSeriesWorks(series.data.items, allWorks);
const seriesCover = series.data.coverImage || '/DefaultCover.png';

// 收集合集中所有作品的标签
const seriesWorksTags = [...new Set(seriesWorks.flatMap(work => work.data.tags || []))];
---

<Base title={series.data.title}>
  <section class="series-detail section">
    <div class="container">
      <!-- Series Header -->
      <header class="series-header">
        <img src={seriesCover} alt={series.data.title} class="series-cover" />
        <div class="series-info">
          <h1 class="series-title">{series.data.title}</h1>
          <p class="series-description">{series.data.description}</p>
          <div class="series-tags">
            {(series.data.tags || []).map(tag => (
              <a href={`/works/tags/${encodeURIComponent(tag)}`} class="tag">#{tag}</a>
            ))}
          </div>
          <div class="series-meta">
            <span class="series-count">{seriesWorks.length} 个作品</span>
            {series.data.date && (
              <time class="series-date">{series.data.date.toLocaleDateString()}</time>
            )}
          </div>
        </div>
      </header>

      <!-- Series Works -->
      <section class="series-works">
        {seriesWorks.length > 0 && seriesWorksTags.length > 0 && (
          <DynamicTagFilter
            id="series-works-filter"
            labels={seriesWorksTags}
            targetType="series-items"
            maxVisible={6}
          />
        )}
        {seriesWorks.length > 0 ? (
          <div class="works-list">
            {seriesWorks.map(work => (
              <a href={`/works/${getContentSlug(work)}`} class="work-item" data-content-type="series-items" data-tags={(work.data.tags || []).join(',')}>
                <h3 class="work-title">{work.data.title}</h3>
                <div class="work-row">
                  {(() => {
                    const heroImg = getHeroImage(work);
                    return heroImg && (
                      <div class="work-cover">
                        <img src={heroImg} alt={work.data.title} />
                      </div>
                    );
                  })()}
                  <div class="work-content">
                    <p class="work-desc">{work.data.description}</p>
                    <div class="work-footer">
                      <div class="work-tags">
                        {(work.data.tags || []).slice(0, 5).map(tag => (
                          <span class="tag">#{tag}</span>
                        ))}
                      </div>
                      {work.data.date && (
                        <time class="work-date">{work.data.date.toLocaleDateString('zh-CN')}</time>
                      )}
                    </div>
                  </div>
                  <span class="work-arrow">&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>该合集暂无作品</p>
          </div>
        )}
      </section>
    </div>
  </section>
</Base>

<style>
  .series-header {
    margin-bottom: var(--space-16);
    text-align: center;
  }

  .series-cover {
    width: 100%;
    max-width: 800px;
    aspect-ratio: 1380 / 560;
    margin: 0 auto var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-base);
  }

  .series-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .series-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .series-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }

  .series-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-6);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .series-tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tag {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .series-tags .tag:hover {
    background: var(--accent);
    color: var(--bg-base);
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-bottom: var(--space-8);
    color: var(--text-primary);
  }

  .works-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .work-item.hidden {
    display: none;
  }

  .work-item {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--bg-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
  }

  .work-item:hover {
    border-color: var(--accent);
    background: var(--accent-glow);
    transform: translateX(4px);
  }

  .work-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    transition: color var(--transition-fast);
  }

  .work-item:hover .work-title {
    color: var(--accent);
  }

  .work-row {
    display: flex;
    gap: var(--space-6);
  }

  .work-cover {
    flex-shrink: 0;
    width: 160px;
    aspect-ratio: 1380 / 560;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-base);
  }

  .work-row.no-image {
    flex-direction: column;
  }

  .work-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .work-item:hover .work-cover img {
    transform: scale(1.05);
  }

  .work-content {
    flex: 1;
    min-width: 0;
  }

  .work-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .work-tags .tag {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: var(--bg-base);
    border: 1px solid var(--bg-border);
  }

  .work-item:hover .work-tags .tag {
    background: transparent;
    border-color: transparent;
  }

  .work-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .work-date {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .work-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    font-size: var(--text-xl);
    color: var(--text-muted);
    transition: all var(--transition-fast);
    align-self: center;
  }

  .work-item:hover .work-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .work-item {
      flex-direction: column;
      align-items: stretch;
    }

    .work-row {
      flex-direction: column;
    }

    .work-cover {
      width: 100%;
    }

    .work-arrow {
      display: none;
    }
  }
</style>
